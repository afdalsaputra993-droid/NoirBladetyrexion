---
// Footer.astro — Footer "Noir & Blade"
// Empat kolom (brand, menu, layanan, kontak) + baris penutup. Fade-in GSAP sekali.

// === Brand & teks umum ===
const BRAND_NAME = 'Noir & Blade';
const TAGLINE = 'Seni mencukur untuk pria berkelas.';
// Nilai YEAR dihitung saat BUILD. Untuk SSG, angka ikut berubah setiap kali `astro build`.
const YEAR = new Date().getFullYear();

// === Kontak (sama dengan yang dipakai di section Kontak) ===
import {WA_NUMBER, WA_MESSAGE, waHref} from "@/utils/whatsApp.js";
const ADDRESS = 'Jl. Contoh No. 12, Jakarta Selatan 12345';
const HOURS = 'Setiap hari, 10.00 - 21.00';
const PHONE_DISPLAY = '0838-3085-6078';
const PHONE_LINK = '+6283830856078';
const INSTAGRAM_HANDLE = '@noirandblade';
const INSTAGRAM_URL = 'https://instagram.com/noirandblade';

// === Kredit ===
const CREDIT_NAME = 'Tyrexion';
const CREDIT_URL = 'https://tyrexion.vercel.app';

// === Daftar tautan ===
const MENU_LINKS = [
  { label: 'Tentang', href: '#tentang' },
  { label: 'Layanan', href: '#layanan' },
  { label: 'Galeri', href: '#galeri' },
  { label: 'Tim', href: '#tim' },
  { label: 'Testimoni', href: '#testimoni' },
  { label: 'Booking', href: '#booking' },
  { label: 'Kontak', href: '#kontak' },
];

const SERVICE_LINKS = [
  'Signature Haircut', 'Beard Trim & Shape', 'Hot Towel Shave',
  'Hair Coloring', 'Kids Cut', 'Paket Groom',
];

// Delay stagger untuk empat kolom
const columnDelays = ['0', '0.1', '0.2', '0.3'];
---

<footer id="footer" class="bg-secondary py-5 footer-section">
  <div class="container">
    <div class="row g-4 g-lg-5">

      <!-- Kolom 1: Brand -->
      <div class="col-12 col-lg-4 reveal" data-delay={columnDelays[0]}>
        <a href="#beranda" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-3">
          <i class="bi bi-scissors text-accent-cta fs-4 lh-1" aria-hidden="true"></i>
          <span class="footer-brand-text">{BRAND_NAME.toUpperCase()}</span>
        </a>
        <p class="text-light opacity-75 mb-4 footer-tagline">{TAGLINE}</p>

        <!-- Ikon sosmed bulat -->
        <div class="d-flex gap-2">
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer"
             class="footer-social" aria-label="Instagram Noir & Blade (membuka tab baru)">
            <i class="bi bi-instagram" aria-hidden="true"></i>
          </a>
          <a href={waHref} target="_blank" rel="noopener noreferrer"
             class="footer-social" aria-label="WhatsApp Noir & Blade (membuka tab baru)">
            <i class="bi bi-whatsapp" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <!-- Kolom 2: Menu -->
      <div class="col-6 col-lg-2 reveal" data-delay={columnDelays[1]}>
        <p class="footer-title text-accent-cta mb-3">Menu</p>
        <nav aria-label="Menu footer">
          <ul class="list-unstyled mb-0">
            {MENU_LINKS.map((link) => (
              <li class="mb-2">
                <a href={link.href} class="footer-link text-light text-decoration-none small">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Kolom 3: Layanan -->
      <div class="col-6 col-lg-2 reveal" data-delay={columnDelays[2]}>
        <p class="footer-title text-accent-cta mb-3">Layanan</p>
        <nav aria-label="Layanan footer">
          <ul class="list-unstyled mb-0">
            {SERVICE_LINKS.map((name) => (
              <li class="mb-2">
                <a href="#layanan" class="footer-link text-light text-decoration-none small">{name}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Kolom 4: Kontak -->
      <div class="col-12 col-lg-4 reveal" data-delay={columnDelays[3]}>
        <p class="footer-title text-accent-cta mb-3">Kontak</p>
        <ul class="list-unstyled mb-0">
          <li class="d-flex align-items-start gap-2 mb-2">
            <i class="bi bi-geo-alt text-accent-cta mt-1" aria-hidden="true"></i>
            <address class="mb-0 text-light opacity-75 small">{ADDRESS}</address>
          </li>
          <li class="d-flex align-items-start gap-2 mb-2">
            <i class="bi bi-clock text-accent-cta mt-1" aria-hidden="true"></i>
            <span class="text-light opacity-75 small">{HOURS}</span>
          </li>
          <li class="d-flex align-items-start gap-2 mb-2">
            <i class="bi bi-telephone text-accent-cta mt-1" aria-hidden="true"></i>
            <a href={`tel:${PHONE_LINK}`} class="footer-link text-light text-decoration-none small">
              {PHONE_DISPLAY}
            </a>
          </li>
          <li class="d-flex align-items-start gap-2">
            <i class="bi bi-instagram text-accent-cta mt-1" aria-hidden="true"></i>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer"
               class="footer-link text-light text-decoration-none small">
              {INSTAGRAM_HANDLE}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Garis pemisah -->
    <hr class="footer-divider my-4" />

    <!-- Baris penutup: 3 elemen tersebar di desktop, bertumpuk di HP -->
    <div class="reveal d-flex flex-column flex-lg-row align-items-center justify-content-between gap-3 text-center text-lg-start">
      <p class="text-light opacity-75 small mb-0">
        &copy; {YEAR} {BRAND_NAME}. Seluruh hak cipta dilindungi.
      </p>

      <div>
        <p class="text-light opacity-75 small mb-1">
          Website demo oleh{' '}
          <a href={CREDIT_URL} target="_blank" rel="noopener noreferrer"
             class="footer-credit text-accent-cta text-decoration-none fw-bold"
             aria-label="Tyrexion (membuka tab baru)">
            {CREDIT_NAME}
          </a>
        </p>
        <p class="text-light opacity-50 footer-credit-note mb-0">
          {BRAND_NAME} adalah bisnis fiktif untuk keperluan demo.
        </p>
      </div>

      <a href="#beranda"
         class="footer-top d-inline-flex align-items-center gap-2 text-light text-decoration-none small"
         aria-label="Kembali ke atas halaman">
        <i class="bi bi-arrow-up" aria-hidden="true"></i>
        <span>Kembali ke atas</span>
      </a>
    </div>
  </div>
</footer>

<!-- Fallback JS mati -->
<noscript><style>#footer .reveal { opacity: 1 !important; }</style></noscript>

<style>
  /* Hook GSAP — scoped, custom.scss tidak disentuh */
  .reveal { opacity: 0; }

  /* Garis atas sebagai pembatas dari section Kontak */
  .footer-section {
    border-top: 1px solid color-mix(in srgb, var(--bs-accent-cta) 25%, transparent);
  }

  /* Brand: Playfair, kapital, letter-spacing renggang */
  .footer-brand-text {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.22em;
    color: var(--bs-light);
    white-space: nowrap;
  }

  .footer-tagline { max-width: 20rem; }

  /* Judul kolom: kecil, uppercase, letter-spacing, accent */
  .footer-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Tautan: warna transisi lembut, tanpa gerak */
  .footer-link { transition: color 0.2s ease; }
  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--bs-accent-cta) !important;
  }

  /* Ikon sosmed: lingkaran 40px, border accent, ikon light → accent saat hover */
  .footer-social {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--bs-accent-cta);
    border-radius: 50%;
    color: var(--bs-light);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .footer-social:hover,
  .footer-social:focus-visible {
    color: var(--bs-accent-cta);
  }

  .footer-divider {
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--bs-accent-cta) 25%, transparent);
    opacity: 1;
  }

  /* Netralkan italic bawaan <address> */
  address { font-style: normal; }

  /* Kredit: hover bergaris bawah */
  .footer-credit:hover,
  .footer-credit:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-credit-note { font-size: 0.7rem; line-height: 1.4; }

  /* Back-to-top: area ketuk ≥44px */
  .footer-top {
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    transition: color 0.2s ease;
  }
  .footer-top:hover,
  .footer-top:focus-visible {
    color: var(--bs-accent-cta) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link, .footer-social, .footer-top { transition: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initFooter = () => {
    const root = document.getElementById('footer');
    if (!root) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const behavior = reduceMotion ? 'auto' : 'smooth';

    // 1) Reveal: fade-in sekali saat masuk layar.
    // start 'top 95%' agar footer terpicu juga bila langsung terlihat di halaman pendek.
    const els = gsap.utils.toArray('#footer .reveal');
    if (els.length) {
      if (reduceMotion) {
        gsap.set(els, { opacity: 1 });
      } else {
        els.forEach((el) => {
          gsap.fromTo(
            el,
            { opacity: 0 },
            {
              opacity: 1,
              duration: 0.8,
              ease: 'power2.out',
              delay: Number(el.dataset.delay) || 0,
              scrollTrigger: { trigger: el, start: 'top 95%', once: true },
            }
          );
        });
      }
    }

    // 2) Smooth scroll untuk tautan anchor footer, offset tinggi navbar fixed.
    // Konsisten dengan Navbar, mencegah judul section tertutup navbar.
    const navbar = document.getElementById('navbar-noir');
    const handleAnchor = (event) => {
      const a = event.currentTarget;
      const href = a.getAttribute('href');
      if (!href || !href.startsWith('#')) return;

      // Kembali ke atas → langsung scrollTo(0)
      if (href === '#beranda') {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior });
        return;
      }

      const target = document.querySelector(href);
      if (!target) return;

      event.preventDefault();
      const offset = (navbar?.offsetHeight || 0) + 8;
      const top = target.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top, behavior });
    };
    root.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', handleAnchor));
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initFooter);
  else initFooter();
</script>