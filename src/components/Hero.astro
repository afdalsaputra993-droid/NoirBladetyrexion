---
// Hero.astro — Section hero "Noir & Blade" (entrance GSAP, tanpa hex)
import {WA_NUMBER, WA_MESSAGE, waHref} from "@/utils/whatsApp.js";
---

<section id="beranda" class="hero position-relative min-vh-100 d-flex align-items-center overflow-hidden 100vh">

  <img
    src="/images/hero-barbershop.jpg"
    alt="Interior barbershop Noir & Blade dengan kursi cukur klasik dan pencahayaan hangat"
    class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover"
    loading="eager"
    decoding="async"
  />

  <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100" aria-hidden="true"></div>

  <div class="container position-relative py-5">
    <div class="row justify-content-center justify-content-lg-start">
      <div class="col-12 col-lg-8 col-xl-7 order-2 order-lg-1 text-center text-lg-start">

        <p class="hero-reveal hero-label d-inline-flex align-items-center text-accent-cta text-uppercase small fw-semibold mb-3 ps-3 border-start border-2 border-accent-cta">
          Barbershop Premium Sejak Tahun Ini
        </p>

        <h1 class="hero-reveal display-3 fw-bold text-light mb-4">
          Seni Mencukur untuk Pria Berkelas
        </h1>

        <p class="hero-reveal fs-5 text-light opacity-75 mb-4 hero-subheadline mx-auto mx-lg-0">
          Potongan presisi, cukur handuk panas, dan suasana tenang di tangan barber berpengalaman. Rasakan perawatan yang membuat Anda keluar dengan percaya diri.
        </p>

        <div class="hero-reveal d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start mb-4 mb-lg-5">
          <a href={waHref} target="_blank" rel="noopener noreferrer"
             class="btn btn-accent-cta btn-lg fw-bold text-primary rounded-1">
            <i class="bi bi-whatsapp me-2" aria-hidden="true"></i>Booking Sekarang
          </a>
          <a href="#layanan" class="btn btn-outline-light btn-lg rounded-1">
            Lihat Layanan
          </a>
        </div>

        <ul class="hero-reveal hero-info list-unstyled d-flex flex-column flex-lg-row align-items-center align-items-lg-start gap-3 gap-lg-0 mb-0">
          <li class="d-flex align-items-center gap-2 small text-light">
            <i class="bi bi-clock text-accent-cta" aria-hidden="true"></i>
            <span>Buka setiap hari, 10.00 - 21.00</span>
          </li>
          <li class="d-flex align-items-center gap-2 small text-light">
            <i class="bi bi-geo-alt text-accent-cta" aria-hidden="true"></i>
            <span>Jl. Contoh No. 12, Jakarta</span>
          </li>
          <li class="d-none d-lg-flex align-items-center gap-2 small text-light">
            <i class="bi bi-star-fill text-accent-cta" aria-hidden="true"></i>
            <span>4,9 dari 500+ ulasan</span>
          </li>
        </ul>

      </div>
      <div class="col-12 col-lg-4 order-1 order-lg-2">
        <div class="ratio" style="--bs-aspect-ratio:100%">
      <img src="/images/heroBarbershop.png" class="object-fit-cover rounded-4 shadow-lg" alt="Gambar samping hero">
        </div>
      </div>
    </div>
  </div>

  <a href="#tentang"
     class="position-absolute bottom-0 start-50 translate-middle-x mb-4 text-light"
     aria-label="Gulir ke bagian tentang">
    <i class="bi bi-chevron-down fs-4" aria-hidden="true"></i>
  </a>
</section>

<!-- Fallback: jika JS mati, semua konten tetap tampil -->
<noscript><style>.hero-reveal { opacity: 1 !important; }</style></noscript>

<style lang="scss">
  .hero {
    padding-top: 6rem;
    padding-bottom: 5rem;
  }

  /* Sembunyikan sementara sebelum GSAP reveal — mencegah flash */
  .hero-reveal {
    opacity: 0;
  }

  .hero-overlay {
    background: linear-gradient(
      90deg,
      rgba(var(--bs-primary-rgb), 0.85) 0%,
      rgba(var(--bs-primary-rgb), 0.70) 55%,
      rgba(var(--bs-primary-rgb), 0.55) 100%
    );
  }

  .hero-label { letter-spacing: 0.18em; }
  .hero-subheadline { max-width: 34rem; }

  @media (min-width: 992px) {
    .hero-info li + li {
      border-left: 1px solid var(--bs-accent-cta);
      padding-left: 1.5rem;
      margin-left: 1.5rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const initHero = () => {
    const targets = gsap.utils.toArray('.hero-reveal');
    if (!targets.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      // Hormati pengaturan pengguna: langsung tampil, tanpa gerak
      gsap.set(targets, { opacity: 1 });
      return;
    }

    // Entrance halus: urut dari atas ke bawah, singkat
    gsap.fromTo(
      targets,
      { opacity: 0, y: 24 },
      {
        opacity: 1,
        y: 0,
        duration: 0.7,
        stagger: 0.1,
        ease: 'power2.out',
        clearProps: 'transform', // bersihkan inline transform agar hover/anchor tetap normal
      }
    );
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHero);
  else initHero();
  </script>