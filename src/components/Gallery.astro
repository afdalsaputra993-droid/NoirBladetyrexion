---
// Gallery.astro — Section "Galeri" Noir & Blade
// 8 foto 1:1 + overlay caption. Fade-in GSAP sekali per elemen.

import gallery1 from '../assets/images/gallery-1.jpg?url';
import gallery2 from '../assets/images/gallery-2.jpg?url';
import gallery3 from '../assets/images/gallery-3.jpg?url';
import gallery4 from '../assets/images/gallery-4.png?url';
import gallery5 from '../assets/images/gallery-5.jpg?url';
import gallery6 from '../assets/images/gallery-6.jpg?url';
import gallery7 from '../assets/images/gallery-7.jpg?url';
import gallery8 from '../assets/images/gallery-8.jpg?url';

const INSTAGRAM_URL = 'https://instagram.com/noirandblade';
const INSTAGRAM_HANDLE = '@noirandblade';

const photos = [
  { image: gallery1, alt: 'Hasil skin fade dilihat dari samping', caption: 'Skin Fade' },
  { image: gallery2, alt: 'Barber merapikan jenggot pelanggan', caption: 'Beard Shape' },
  { image: gallery3, alt: 'Kursi cukur kulit di depan cermin', caption: 'Ruang Cukur' },
  { image: gallery4, alt: 'Gunting, sisir, dan pisau cukur tertata rapi', caption: 'Alat Kami' },
  { image: gallery5, alt: 'Pelanggan menerima hot towel', caption: 'Hot Towel' },
  { image: gallery6, alt: 'Hasil potongan classic side part', caption: 'Classic Cut' },
  { image: gallery7, alt: 'Rak produk perawatan rambut dan jenggot', caption: 'Produk Premium' },
  { image: gallery8, alt: 'Area tunggu dengan kopi hangat', caption: 'Area Santai' },
];

// Stagger per baris (4 kolom di desktop): 0, 0.1, 0.2, 0.3 lalu ulang
const photoDelays = photos.map((_, i) => ((i % 4) * 0.1).toFixed(1));
---

<section id="galeri" class="bg-primary py-5">
  <div class="container">

    <!-- Kepala section -->
    <div class="text-center mb-5">
      <p class="gallery-label reveal text-accent-cta mb-2">Galeri</p>
      <h2 class="reveal text-light fw-bold display-6 mb-3">Karya dan Suasana Kami</h2>
      <p class="reveal text-light opacity-75 mx-auto gallery-sub mb-0">
        Sekilas hasil potongan, detail jenggot, dan suasana nyaman di Noir &amp; Blade.
      </p>
    </div>

    <!-- Grid foto -->
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-2 g-lg-3">
      {photos.map((photo, i) => (
        <div class="col">
          <figure
            class="gallery-item ratio ratio-1x1 overflow-hidden rounded-1 position-relative mb-0"
            tabindex="0"
          >
            <img
              src={photo.image}
              alt={photo.alt}
              width={600}
              height={600}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              class="object-fit-cover"
            />
            <figcaption class="gallery-overlay position-absolute bottom-0 start-0 end-0">
              <span class="gallery-caption-label border-top border-accent-cta pt-2 d-block">
                {photo.caption}
              </span>
            </figcaption>
          </figure>
        </div>
      ))}
    </div>

    <!-- Footer -->
    <div class="text-center mt-5">
      <a
        href={INSTAGRAM_URL}
        class="btn btn-outline-accent-cta btn-lg rounded-1 reveal d-inline-flex align-items-center gap-2"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ikuti Noir & Blade di Instagram"
      >
        <i class="bi bi-instagram" aria-hidden="true"></i>
        Ikuti di Instagram
      </a>
      <p class="reveal text-light opacity-75 small mt-3 mb-0">{INSTAGRAM_HANDLE}</p>
    </div>
  </div>
</section>

<!-- Fallback JS mati -->
<noscript><style>#galeri .reveal { opacity: 1 !important; }</style></noscript>

<style>
  /* Hook GSAP — scoped, custom.scss tidak disentuh */
  .reveal { opacity: 0; }

  /* Label aksen */
  .gallery-label {
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    font-size: 0.8rem;
  }
  .gallery-sub { max-width: 36rem; }

  /* Overlay caption: gradasi dari bawah (primary) ke atas (transparan) */
  .gallery-overlay {
    padding: 2rem 0.9rem 0.75rem;
    background: linear-gradient(
      to top,
      rgba(var(--bs-primary-rgb), 0.92) 0%,
      rgba(var(--bs-primary-rgb), 0.55) 55%,
      rgba(var(--bs-primary-rgb), 0) 100%
    );
    transition: opacity 0.3s ease;
    pointer-events: none; /* jangan blokir hover ke kartu */
  }

  .gallery-caption-label {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--bs-light);
  }

  /* Focus ring untuk navigasi keyboard (overlay bisa di-trigger via :focus) */
  .gallery-item:focus-visible {
    outline: 2px solid var(--bs-accent-cta);
    outline-offset: 2px;
  }

  /* Perangkat dengan hover: overlay tersembunyi, muncul saat hover/focus */
  @media (hover: hover) and (pointer: fine) {
    .gallery-overlay { opacity: 0; }
    .gallery-item:hover .gallery-overlay,
    .gallery-item:focus .gallery-overlay,
    .gallery-item:focus-within .gallery-overlay { opacity: 1; }
  }

  /* Perangkat sentuh: keterangan selalu tampil, gradasi lebih tipis */
  @media (hover: none) {
    .gallery-overlay {
      background: linear-gradient(
        to top,
        rgba(var(--bs-primary-rgb), 0.85) 0%,
        rgba(var(--bs-primary-rgb), 0.35) 60%,
        rgba(var(--bs-primary-rgb), 0) 100%
      );
    }
  }

  /* Reduce motion: matikan transisi overlay */
  @media (prefers-reduced-motion: reduce) {
    .gallery-overlay { transition: none; }
  }

  /* Tombol Instagram selebar layar di HP */
  @media (max-width: 575.98px) {
    #galeri .btn-outline-accent-cta { width: 100%; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initGallery = () => {
    const els = gsap.utils.toArray('#galeri .text-center .reveal');
    if (!els.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      gsap.set(els, { opacity: 1 });
      return;
    }

    // Fade-in sekali saat masuk viewport. Tanpa gerak posisi/scale.
    els.forEach((el) => {
      gsap.fromTo(
        el,
        { opacity: 0 },
        {
          opacity: 1,
          duration: 0.5,
          ease: 'power2.out',
          delay: 0,
          scrollTrigger: { trigger: el, start: 'top 85%', once: true },
        }
      );
    });
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initGallery);
  else initGallery();
</script>